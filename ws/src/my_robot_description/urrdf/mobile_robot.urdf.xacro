<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile">
    <xacro:include filename="common_properties.xacro"/>
    <xacro:include filename="mobile_base.xacro"/>
    <link name="base_footprint"/>
    <xacro:wheel prefix="right_back"/>
    <xacro:wheel prefix="left_back"/>
    <xacro:wheel prefix="right_front"/>
    <xacro:wheel prefix="left_front"/>
    <xacro:body name="base_link"/>
    <link name="lidar_cylinder">
        <visual>
            <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.05" length="0.08"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.05" length="0.08"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.1" r="0.05" l="0.08" o_xyz="0 0 0.04" o_rpy="0 0 0"/>
    </link>
    <joint name="body" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
    </joint>
    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_cylinder"/>
        <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    </joint>
    <joint name="right_back" type="continuous">
        <parent link="base_link"/>
        <child link="right_back_wheel"/>
        <origin xyz="-${base_length/3} -${base_width/2 + wheel_length/2} 0" rpy="0 0 0"/>
        <limit effort="100" velocity="100"/>
        <axis xyz="0 1 0"/>
    </joint>
    <joint name="left_back" type="continuous">
        <parent link="base_link"/>
        <child link="left_back_wheel"/>
        <origin xyz="-${base_length/3} ${base_width/2 + wheel_length/2} 0" rpy="0 0 0"/>
        <limit effort="100" velocity="100"/>
        <axis xyz="0 1 0"/>
    </joint>
    <joint name="right_front" type="continuous">
        <parent link="base_link"/>
        <child link="right_front_wheel"/>
        <origin xyz="${base_length/3} -${base_width/2 + wheel_length/2} 0" rpy="0 0 0"/>
        <limit effort="100" velocity="100"/>
        <axis xyz="0 1 0"/>
    </joint>
    <joint name="left_front" type="continuous">
        <parent link="base_link"/>
        <child link="left_front_wheel"/>
        <origin xyz="${base_length/3} ${base_width/2 + wheel_length/2} 0" rpy="0 0 0"/>
        <limit effort="100" velocity="100"/>
        <axis xyz="0 1 0"/>
    </joint>

    <gazebo>
        <plugin 
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
            <left_joint>left_front</left_joint>
            <left_joint>left_back</left_joint>
            <right_joint>right_front</right_joint>
            <right_joint>right_back</right_joint>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <wheel_separation>0.45</wheel_separation>
            <wheel_radius>0.1</wheel_radius>
            <topic>/cmd_vel</topic>
            <!-- <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic> -->
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            
        </plugin>
        <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <dimensions>3</dimensions>
        </plugin>
        <plugin 
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        </plugin>
    </gazebo>
    <gazebo reference="lidar_cylinder">
        <sensor name="gpu_lidar" type="gpu_lidar">
            <lidar>
                <scan>
                    <horizontal>
                        <samples>1800</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.1459</min_angle>
                        <max_angle>3.1459</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>16</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.261799</min_angle>
                        <max_angle>0.261799</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.04</min>
                    <max>8</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
            <gz_frame_id>lidar_cylinder</gz_frame_id>
            <topic>/scan</topic>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
        </sensor>
    </gazebo>
    <gazebo>
        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>
</robot>
